# Postgres connection string from Neon / Supabase / etc.
# Example: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Optional: shared secret protecting the /api/cron/sync endpoint
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Hard cap on rows per source (qatarliving, qatarsale). After each successful
# sync, the oldest rows by lastSeenAt are deleted until the source is at this
# count. Default 500.
PRUNE_MAX_PER_SOURCE=500
